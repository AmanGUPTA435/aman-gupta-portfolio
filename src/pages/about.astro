---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = [
  'Rust',
  'Go',
  'C/C++',
  'Python',
  'TypeScript',
  'JavaScript',
  'Tokio',
  'Tonic',
  'Axum',
  'SQLx',
  'PostgreSQL',
  'Docker',
  'Solidity',
  'Move',
  'Ethereum',
  'Aptos',
  'gRPC',
  'Distributed systems',
  'Networking',
  'Cryptography',
];
---

<BaseLayout title="About" description={`About ${SITE.name}, a Rust backend and blockchain infrastructure engineer.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-2xl text-3xl font-medium sm:text-4xl">
      Backend and blockchain engineering, with a focus on systems that need to be understood deeply.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-2xl">
      <p>
        I'm a backend and blockchain engineer with professional experience building production
        infrastructure in Rust at Supra. My work there involved indexing services, RPC systems and
        asynchronous backend services.
      </p>
      <p>
        I've also worked on DeFi and smart contract related systems at AVEX, and I spend a lot of my
        own time building projects to understand systems more deeply.
      </p>
      <p>
        I'm especially interested in backend infrastructure, distributed systems, blockchain nodes
        and RPCs, indexing, transaction systems, wallets, payments, DeFi and protocol engineering.
      </p>
      <p>
        I prefer working on systems where I can understand how the pieces fit together and take
        ownership of more than just a small isolated part.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools and areas</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
