---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/utils/formatDate';

export async function getStaticPaths() {
  const entries = await getCollection('notes', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
const { title, summary, date, dateLabel, tags } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <a href="/notes" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
      ← All notes
    </a>

    <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">
      {title}
    </h1>

    <dl
      class="border-line text-ink-soft mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs"
    >
      <div><dt class="inline">Date - </dt><dd class="inline">{dateLabel ?? formatDate(date)}</dd></div>
      {
        tags.length > 0 && (
          <div>
            <dt class="inline">Topics - </dt>
            <dd class="inline">{tags.join(', ')}</dd>
          </div>
        )
      }
    </dl>

    <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl">
      <Content />
    </div>
  </article>
</BaseLayout>
