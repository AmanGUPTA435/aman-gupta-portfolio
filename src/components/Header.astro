---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-display text-ink shrink-0 text-lg font-medium">
      {SITE.name}
    </a>

    <nav class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 sm:gap-x-5" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = link.href !== '/#contact' && (currentPath === link.href || currentPath.startsWith(`${link.href}/`));
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-[11px] tracking-wide uppercase transition-colors sm:text-xs',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
